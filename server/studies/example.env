# Study settings template. Copy to e.g. studies/mpe-pilot.env and run:
#   STUDY_CONFIG=studies/mpe-pilot.env npm run dev        (in server/)
# Real study files are gitignored because they hold completion codes.
# Variables set in the shell override this file.

# ---- Study ----
# Written into every data log so each file says which study/condition it is.
# Use one settings file per condition (e.g. studies/mpe-pilot-a.env).
STUDY_NAME=mpe-pilot
CONDITION=default

# ---- Group ----
# Players per group (room). Overcooked: 1 up to the layout's spawn count (10 for open_room)
REQUIRED_PLAYERS=3
# Rounds each group plays. After the last one the group is finished: leaving no
# longer counts as dropping out, and finishers get COMPLETION_URL on the final
# screen. Must equal the number of "game" screens in the client timeline.
ROUNDS=1
# Once a group has started, abort the study for everyone if drop-outs leave
# fewer than this many players. Empty = REQUIRED_PLAYERS (any drop-out ends it).
MIN_GROUP_SIZE=3
# How long a participant may wait in the lobby for a group, in ms (0 = no limit).
# After that their study ends as "no group" (paid per PAY_NO_GROUP below).
LOBBY_TIMEOUT_MS=600000
# How many groups (rooms) this server run may open; empty = unlimited. Once
# reached, newcomers who can't join an open group are told the study is full
# (also "no group"). Handy for running a fixed batch.
MAX_ROOMS=
# Smallest group to start: when someone in a waiting group reaches the lobby
# timeout and at least this many people are waiting, the group is resized to
# them and starts (instead of ending as "no group"). Empty = never start short.
MIN_START_SIZE=
# Group size, minimum group size, smallest group to start, lobby timeout and
# MAX_ROOMS can also be changed live from the admin view (until the server restarts).

# ---- Solo practice (Overcooked) ----
# Before the lobby, each participant practices alone in PRACTICE_LAYOUT until
# one attempt serves PRACTICE_MIN_SOUPS soups (unlimited attempts), within
# PRACTICE_TIME_LIMIT_MS of starting practice (0 = no limit). Only those who pass
# can join a group. With PRACTICE=false the client's practice screen is skipped.
PRACTICE=false
PRACTICE_LAYOUT=cramped_room
# Steps per attempt (x TICK_MS; 600 x 100 ms = 60 s)
PRACTICE_HORIZON=600
PRACTICE_MIN_SOUPS=1
PRACTICE_TIME_LIMIT_MS=600000

# ---- Game ----
# mpe (simple_spread) or overcooked (classic onion soup, 1-10 cooks)
GAME=mpe
# Overcooked only: layout file sidecar/layouts/<LAYOUT>.txt. It must have at
# least REQUIRED_PLAYERS spawn points (open_room has 10); the server refuses
# to start otherwise. Players get the spawns in letter order (a, b, c, ...).
LAYOUT=open_room
# Steps per trial; trial length = HORIZON x TICK_MS (3000 x 100 ms = 5 min).
# Overcooked moves one cell per key press, applying at most one press per
# player per tick, so TICK_MS also caps how fast cooks can move; tune in piloting.
HORIZON=3000
TICK_MS=100
# Environment seed. By default every room uses SEED, so every group plays the
# same sequence of starting layouts (matched across groups). SEED_PER_ROOM=true
# gives room_k seed SEED + k - 1 instead. Each episode's starting state is
# logged either way (trial_start.initialState).
SEED=123
SEED_PER_ROOM=false

# ---- Completion ----
# Where participants who finish every round are sent (Prolific: the study's
# completion URL with your "completed" code). Given out by the server only to
# participants it saw finish, on the study's final screen.
COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=REPLACE_ME

# ---- Payment for early endings ----
# aborted = our side (server stopped/crashed, environment failure, group fell
#           below MIN_GROUP_SIZE). no group = see LOBBY_TIMEOUT_MS / MAX_ROOMS.
#           dropped = participant left / disconnected
#           longer than the grace period. People who never got a seat (e.g.
#           still on consent) are never paid.
# Use a separate Prolific completion code per outcome, and set each code's
# action in Prolific (e.g. approve automatically) so no manual review is needed.
PAY_ABORTED=true
ABORTED_COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=REPLACE_ME
# no group = we couldn't place them in a group (lobby timed out, or study full)
PAY_NO_GROUP=true
NO_GROUP_COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=REPLACE_ME
# practice timeout = didn't pass practice within PRACTICE_TIME_LIMIT_MS
PAY_PRACTICE_TIMEOUT=false
PRACTICE_TIMEOUT_COMPLETION_URL=
PAY_DROPPED=false
# Optional: where to send dropped participants (e.g. a code whose Prolific
# action is "request return"). Leave empty to send them nowhere.
DROPPED_COMPLETION_URL=

# ---- Disconnects ----
# How long a disconnected player's seat is held before they count as gone
LOBBY_GRACE_MS=10000
TRIAL_GRACE_MS=30000

# ---- Off-server data backup ----
# Copies server/data to S3-compatible storage (DigitalOcean Spaces, AWS S3,
# Backblaze B2, ...): each log when it closes, every changed file every
# BACKUP_INTERVAL_MS, and a final pass on shutdown. Leave BACKUP_S3_BUCKET
# empty to turn backup off (the server warns). Turn on bucket versioning.
# Keep access keys out of this file if it is shared: set them in the shell
# or the service's environment instead.
BACKUP_S3_BUCKET=
# DigitalOcean Spaces: https://<region>.digitaloceanspaces.com ; empty for AWS
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
# Folder in the bucket (default: STUDY_NAME)
# BACKUP_PREFIX=
BACKUP_INTERVAL_MS=300000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Admin view ----
# Read-only live view of rooms, participants and server health at
# http(s)://<server>/admin (same port as the game). Off unless set. Use a long
# random value (e.g. openssl rand -hex 24), serve it over HTTPS only, and keep
# it out of shared copies of this file.
ADMIN_TOKEN=

# ---- Infrastructure ----
PORT=8080
# Interface to listen on; unset = all. The deployment (deploy/) sets 127.0.0.1
# so only the HTTPS proxy can reach the server.
# HOST=127.0.0.1
SIDECAR_URL=http://127.0.0.1:8001
# Where JSONL data logs are written (default server/data): one file per room
# plus one <run>_participants.jsonl (consent, screens, survey answers)
# DATA_DIR=/path/to/data
# If the game environment can't be created, retry every START_RETRY_MS, then
# abort after MAX_START_RETRIES attempts (~2 min)
START_RETRY_MS=3000
MAX_START_RETRIES=40
# Code version to record when the server runs without a .git folder
# (otherwise the git commit is read automatically)
# CODE_VERSION=
