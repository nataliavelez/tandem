# Settings for the headless tests (bots.js, reconnect.js, groupsize.js, datalog.js).
#   STUDY_CONFIG=test/test.env npm run dev        (in server/; sidecar on :8001)
PORT=8090
STUDY_NAME=headless-tests
CONDITION=test
SEED=123
REQUIRED_PLAYERS=3
MIN_GROUP_SIZE=2
HORIZON=30
LOBBY_GRACE_MS=2000
TRIAL_GRACE_MS=3000
PAY_ABORTED=true
ABORTED_COMPLETION_URL=https://example.test/complete?cc=TEST_ABORTED
PAY_DROPPED=false
DROPPED_COMPLETION_URL=
