# Tandem game server (local only: 127.0.0.1:8080, reached through Caddy).
# Settings: /etc/tandem/tandem.env (which study file, secrets), then the study file.
# Stopping it ends the study for everyone connected (paid per PAY_ABORTED), so
# restart it only between sessions. Installed by deploy/setup.sh.
[Unit]
Description=Tandem game server
After=network.target tandem-sidecar.service
Wants=tandem-sidecar.service

[Service]
User=tandem
WorkingDirectory=/opt/tandem/app/server
EnvironmentFile=/etc/tandem/tandem.env
ExecStart=/usr/bin/node -r ts-node/register/transpile-only src/index.ts
# The server ends sessions and uploads the final backup on SIGTERM (forced exit after 10 s)
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
