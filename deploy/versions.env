# Versions the deployment installs (read by deploy/setup.sh and deploy/update.sh).
# Change these deliberately, and record why in Updates.txt.

# JaxMARL commit the sidecar was tested with (also recorded in every data log as
# spec.versions.jaxmarl_commit). The lab fork, "scaling" branch: the commit of the
# pots x order sweep (scaling_kitchen, num_pots / nearest placement, pot_cook_time,
# recipe_size, order_size, no_collision), so people play the exact sweep game.
# 2026-11-12: was FLAIROx/jaxmarl 0df1722eacdc884832b520e596101ba33bd9969d.
JAXMARL_REPO=https://github.com/emieczkowski/JaxMARL.git
JAXMARL_COMMIT=3813f07631192f185c2feada39eea1656d8bde89

# Python for the sidecar (packages: sidecar/requirements-lock.txt)
PYTHON_VERSION=3.10

# Node.js major version (local development uses 24)
NODE_MAJOR=24
